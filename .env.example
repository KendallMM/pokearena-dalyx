ENVIRONMENT=development

MYSQL_DATABASE=pokearena
MYSQL_USER=pokearena
MYSQL_PASSWORD=cambiar-esta-clave
MYSQL_ROOT_PASSWORD=cambiar-esta-clave-root

MONGO_DATABASE=pokearena

JWT_SECRET=cambiar-por-un-secreto-largo-de-32-caracteres-o-mas
JWT_ISSUER=pokearena
JWT_AUDIENCE=pokearena-admin
JWT_EXPIRATION_MINUTES=15

# Cliente OAuth de tipo aplicación web (no requiere client secret).
GOOGLE_CLIENT_ID=
PUBLIC_APP_URL=http://localhost:5173
GOOGLE_TIMEOUT_SECONDS=5
LOGIN_CHALLENGE_SECONDS=300

# Una copia de cada carta del catálogo indicada por su código. JSON sin duplicados.
# Debe definirse según las reglas del producto; vacío deja la entrega pendiente.
INITIAL_CARD_CODES=[]
# Definir explícitamente la cantidad aprobada de cubos iniciales.
INITIAL_CUBES=
INITIAL_COLLECTION_RETRY_SECONDS=60
