# Copie este archivo a .env y cambie TODOS los valores. No suba .env al repositorio.

# MySQL
MYSQL_ROOT_PASSWORD=cambie-esta-clave-root
MYSQL_DATABASE=pokearena
MYSQL_USER=pokearena
MYSQL_PASSWORD=cambie-esta-clave-mysql

# MongoDB
MONGO_DB_NAME=pokearena

# API (los secretos deben tener al menos 32 caracteres)
JWT_SECRET=cambie-este-secreto-jwt-de-al-menos-32-caracteres
CURSOR_SECRET=cambie-este-secreto-cursor-de-al-menos-32-caracteres
# JWT_ISSUER=
# JWT_AUDIENCE=
# JWT_ALGORITHMS=HS256
IMAGE_MAX_ATTEMPTS=5
IMAGE_WORKER_POLL_SECONDS=5
TEMPORARY_IMAGE_TTL_SECONDS=3600
