ENVIRONMENT=development

MYSQL_DATABASE=pokearena
MYSQL_USER=pokearena
MYSQL_PASSWORD=cambiar-esta-clave
MYSQL_ROOT_PASSWORD=cambiar-esta-clave-root

MONGO_DATABASE=pokearena

JWT_SECRET=cambiar-por-un-secreto-largo-de-32-caracteres-o-mas
JWT_ISSUER=pokearena
JWT_AUDIENCE=pokearena-admin
JWT_EXPIRATION_MINUTES=15

# Cliente OAuth de tipo aplicación web (no requiere client secret).
GOOGLE_CLIENT_ID=
PUBLIC_APP_URL=http://localhost:5173
GOOGLE_TIMEOUT_SECONDS=5
LOGIN_CHALLENGE_SECONDS=300

# Espera del planificador entre reintentos de una colección inicial pendiente.
INITIAL_COLLECTION_RETRY_SECONDS=60

# Emparejamiento periódico y límite por jugador para POST /v1/busquedas.
MATCHMAKING_INTERVAL_SECONDS=2
# Valores provisionales para la consulta y expiración de búsquedas.
VITE_SEARCH_POLL_SECONDS=3
SEARCH_EXPIRY_INTERVAL_SECONDS=10
SEARCH_INACTIVITY_SECONDS=15
# Valor para desarrollo local.
REDIS_MAXMEMORY=64mb
SEARCH_REQUEST_LIMIT=30
SEARCH_REQUEST_WINDOW_SECONDS=60
